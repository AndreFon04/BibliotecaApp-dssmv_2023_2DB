<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".InstructorsDeleteScreen">

    <TextView
            android:text="Initials:"
            android:layout_width="78dp"
            android:layout_height="23dp"
            android:id="@+id/textView2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="317dp"
            app:layout_constraintBottom_toTopOf="@+id/editTextText2_InstDelete"/>
    <EditText
            android:text=""
            android:layout_width="394dp"
            android:layout_height="59dp"
            android:inputType="text"
            android:ems="10"
            android:id="@+id/editTextText_InstDelete"
            app:layout_constraintTop_toBottomOf="@+id/textView2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="1dp"
            app:layout_constraintBottom_toTopOf="@+id/textView3"/>
    <TextView
            android:text="Name:"
            android:layout_width="78dp"
            android:layout_height="23dp"
            android:id="@+id/textView3"
            app:layout_constraintBottom_toTopOf="@+id/editTextText2_InstDelete"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="317dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextText_InstDelete"/>
    <EditText
            android:text=""
            android:layout_width="394dp"
            android:layout_height="59dp"
            android:inputType="text"
            android:ems="10"
            android:id="@+id/editTextText2_InstDelete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="711dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="1dp"
            app:layout_constraintTop_toBottomOf="@+id/textView3"/>
    <Button
            android:text="Delete"
            android:layout_width="185dp"
            android:layout_height="49dp"
            android:id="@+id/button1_InstDelete"
            android:layout_marginTop="30dp"
            app:layout_constraintEnd_toStartOf="@+id/button2_InstDelete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="633dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextText2_InstDelete"/>
    <Button
            android:text="Cancel"
            android:layout_width="187dp"
            android:layout_height="48dp"
            android:id="@+id/button2_InstDelete"
            android:layout_marginTop="30dp"
            app:layout_constraintTop_toBottomOf="@+id/editTextText2_InstDelete"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="633dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintStart_toEndOf="@+id/button1_InstDelete"/>

</androidx.constraintlayout.widget.ConstraintLayout>